{
  "name": "cartogram",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "geo": "node scripts/build-geo.mjs",
    "flags": "node scripts/build-flags.mjs",
    "seed": "node --env-file-if-exists=.env.local scripts/seed.mjs",
    "setup": "npm run geo && npm run flags && npm run migrate && npm run seed",
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts tests/db/*.test.ts",
    "test:db": "tsx --test --test-concurrency=1 tests/db/*.test.ts",
    "moderate": "node --env-file-if-exists=.env.local --import tsx scripts/moderate.ts"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "next": "^15.5.0",
    "pg": "^8.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "versor": "^0.2.0"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/topojson-client": "^3.1.5",
    "flag-icons": "^7.5.0",
    "mapshaper": "^0.6.102",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0"
  }
}
